# ==========================================
# ISO Middleware Environment Configuration
# ==========================================

PORT=5001
HOST=0.0.0.0

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/isochat?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/isochat
MONGODB_DB_NAME=isochat
MONGODB_POOL_SIZE=10

# AI Provider Keys (Optional for live LLM completions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
